# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
#
# `.env` holds your real secrets and is git-ignored.
# This file has NO real values and IS committed - it documents which
# settings exist so a new developer (or CI, or production) knows what to set.

# ---- Application ---------------------------------------------------------
# ENVIRONMENT=local
APP_NAME="WorkOS API"
# ENVIRONMENT=local|test|staging|production

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Where the browser is allowed to send requests from. Added in iteration 18,
# when we actually install the CORS middleware. Do not use "*" with credentials.
# CORS_ORIGINS=http://localhost:3000

# ---- Database (iteration 02) --------------------------------------------
# Created by `docker compose up db` - see the compose file in iteration 02.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=workos
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/workos

# ---- Redis (iteration 17) -----------------------------------------------
# REDIS_URL=redis://localhost:6379/0

# ---- Auth (iterations 06+) ----------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# A new SECRET_KEY invalidates every issued JWT. Treat it as a production secret.
# SECRET_KEY=replace-me-with-a-long-random-value
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Google OAuth (iteration 15) ----------------------------------------
# Created by you in Google Cloud Console. I will walk you through it then.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
